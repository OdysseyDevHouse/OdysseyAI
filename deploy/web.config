<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole IIS site for OdysseyAI.

  This folder is the site's physical path and contains nothing but this file.
  IIS serves no bytes of its own: every request, including /_next/static and
  /uploads, is handed to the Next server on 127.0.0.1:4100, which knows about
  cache headers, immutable asset hashes and streamed responses in a way a
  static handler does not.

  Requires, on the VM, in this order:
    - URL Rewrite 2.1
    - Application Request Routing 3.0
    - ARR's server-level proxy ENABLED, with "preserve client host header" on
  iis-setup.ps1 does all three; see the note there for why the host header is
  not optional.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="OdysseyAI reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:4100/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!--
      Let the app's own responses through untouched.

      Without this, IIS replaces the BODY of any 4xx/5xx the app returns with
      its own error page — so a JSON API error becomes an HTML page the client
      cannot parse, and Next's not-found and error boundaries never reach the
      browser. The status code was right all along; only the body was wrong,
      which is what makes it such a slow thing to diagnose.
    -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!--
          12MB. The app accepts uploads up to 10MB (MAX_UPLOAD_BYTES in
          src/lib/uploads.ts, matched by serverActions.bodySizeLimit); the
          headroom covers multipart framing. IIS rejects an oversized body
          before the app sees it, so if this were the smaller of the two the
          user would get a bare IIS 404.13 instead of the sentence naming the
          limit.
        -->
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
