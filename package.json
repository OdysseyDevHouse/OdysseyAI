{
  "name": "odyssey-ai",
  "version": "0.1.0",
  "private": true,
  "description": "OdysseyAI — multi-store point of sale back office (web + Windows)",
  "author": "Point of Sale (Pty) Ltd",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/free-port.mjs 4100",
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "next lint",
    "dev:desktop": "concurrently -k -n next,electron -c blue,magenta \"npm:dev:desktop:next\" \"npm:dev:desktop:electron\"",
    "dev:desktop:next": "node scripts/free-port.mjs 4100 && cross-env APP_MODE=desktop NEXT_PUBLIC_APP_MODE=desktop next dev -p 4100",
    "dev:desktop:electron": "wait-on -t 60000 http://localhost:4100/api/health && cross-env ELECTRON_DEV_URL=http://localhost:4100 electron .",
    "build:desktop": "cross-env APP_MODE=desktop NEXT_PUBLIC_APP_MODE=desktop next build",
    "dist": "npm run build:desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "jose": "^5.9.6",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.11.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  }
}
