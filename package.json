{
  "name": "odyssey-ai",
  "version": "0.1.0",
  "private": true,
  "description": "OdysseyAI — multi-store point of sale back office (web + Windows)",
  "author": "Point of Sale (Pty) Ltd",
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/free-port.mjs 4100",
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "next lint",
    "dev:desktop": "concurrently -k -n next,electron -c blue,magenta \"npm:dev:desktop:next\" \"npm:dev:desktop:electron\"",
    "dev:desktop:next": "node scripts/free-port.mjs 4100 && cross-env APP_MODE=desktop NEXT_PUBLIC_APP_MODE=desktop next dev -p 4100",
    "dev:desktop:electron": "wait-on -t 60000 http://localhost:4100/api/health && cross-env ELECTRON_DEV_URL=http://localhost:4100 electron .",
    "build:desktop": "cross-env APP_MODE=desktop NEXT_PUBLIC_APP_MODE=desktop next build",
    "dist": "npm run build:desktop && electron-builder --win --publish never",
    "test:math": "tsx scripts/test-document-math.ts",
    "test:sequences": "tsx --conditions=react-server --env-file=.env scripts/test-sequences.ts",
    "test": "npm run test:math && npm run test:sequences && npm run test:posting && npm run test:account-sales && npm run test:account-types && npm run test:laybys && npm run test:credit-notes && npm run test:void && npm run test:cashup && npm run test:purchasing && npm run test:locations && npm run test:transfers && npm run test:sales-orders && npm run test:composition && npm run test:serials && npm run test:grv-serials && npm run test:supplier-returns && npm run test:product-setup && npm run test:sales-edit && npm run test:opening-balances && npm run test:statement-runs && npm run test:payment-runs && npm run test:party-records",
    "test:posting": "tsx --conditions=react-server --env-file=.env scripts/test-sales-posting.ts",
    "test:account-sales": "tsx --conditions=react-server --env-file=.env scripts/test-account-sales.ts",
    "test:credit-notes": "tsx --conditions=react-server --env-file=.env scripts/test-credit-notes.ts",
    "test:cashup": "tsx --conditions=react-server --env-file=.env scripts/test-cashup.ts",
    "test:purchasing": "tsx --conditions=react-server --env-file=.env scripts/test-purchasing.ts",
    "test:statement-runs": "tsx --conditions=react-server --env-file=.env scripts/test-statement-runs.ts",
    "test:payment-runs": "tsx --conditions=react-server --env-file=.env scripts/test-payment-runs.ts",
    "test:sales-orders": "tsx --conditions=react-server --env-file=.env scripts/test-sales-orders.ts",
    "test:opening-balances": "tsx --conditions=react-server --env-file=.env scripts/test-opening-balances.ts",
    "test:composition": "tsx --conditions=react-server --env-file=.env scripts/test-composition.ts",
    "test:serials": "tsx --conditions=react-server --env-file=.env scripts/test-serials.ts",
    "test:product-setup": "tsx --conditions=react-server --env-file=.env scripts/test-product-setup.ts",
    "test:grv-serials": "tsx --conditions=react-server --env-file=.env scripts/test-grv-serials.ts",
    "test:supplier-returns": "tsx --conditions=react-server --env-file=.env scripts/test-supplier-returns.ts",
    "test:sales-edit": "tsx --conditions=react-server --env-file=.env scripts/test-sales-edit.ts",
    "test:void": "tsx --conditions=react-server --env-file=.env scripts/test-void.ts",
    "test:account-types": "tsx --conditions=react-server --env-file=.env scripts/test-account-types.ts",
    "test:laybys": "tsx --conditions=react-server --env-file=.env scripts/test-laybys.ts",
    "test:locations": "tsx --conditions=react-server --env-file=.env scripts/test-locations.ts",
    "test:party-records": "tsx --conditions=react-server --env-file=.env scripts/test-party-records.ts",
    "test:transfers": "tsx --conditions=react-server --env-file=.env scripts/test-transfers.ts",
    "seed:stress": "node --env-file=.env scripts/seed-stress.mjs",
    "seed:stress:small": "node --env-file=.env scripts/seed-stress.mjs 1 --docs=100000 --grvs=2000 --orders=2000",
    "seed:stress:medium": "node --env-file=.env scripts/seed-stress.mjs 1 --docs=1000000 --grvs=10000 --orders=10000",
    "seed:stress:full": "node --env-file=.env scripts/seed-stress.mjs 1 --docs=4000000 --grvs=20000 --orders=20000",
    "seed:stress:wipe": "node --env-file=.env scripts/seed-stress.mjs 1 --wipe"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "jose": "^5.9.6",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.11.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "wait-on": "^8.0.1"
  }
}
