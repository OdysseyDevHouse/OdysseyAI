node_modules/
.next/
out/
dist/
release/
*.tsbuildinfo
next-env.d.ts

.env
.env.local
.env.*.local

# Screenshots from scripts/screenshot.mjs — verification output, and they can
# contain real customer data pulled from the dev database.
.screenshots/

# Customer and supplier documents. Real business paperwork — never in git.
# Backed up alongside the site databases, not with the source.
uploads/

# Isolated checkouts for parallel agent sessions. Each is a full working tree
# with its own node_modules and .env, and its work reaches main by merging its
# branch — never by being committed from here. Tracking them would put a second
# copy of the whole repo inside the repo.
.claude/worktrees/

.DS_Store
Thumbs.db

# Baked cloud credentials for a packaged desktop build — never commit.
electron/buildDefaults.json
build/app-package.json

# MariaDB binaries for the Database Setup build — ~300MB of third-party
# binaries on their own release cadence. See docs/local-backend.md.
vendor/mariadb/

# Per-BUILD marker, not a repo fact: committed, it would silently make every
# build a local one. See docs/local-backend.md.
build/backend.txt

# Deploy staging output. A full copy of a build (~150MB) plus the bundled
# process manager, rebuilt by deploy/deploy-local.ps1 on demand.
deploy/staged/
deploy/staged*.zip
