# Copy this file to `.env` and fill in the values. `.env` is gitignored —
# never commit real secrets.

# ── Control database ───────────────────────────────────────────────────
# odyssey_tickets. Holds cp2_users (who may sign in), cp2_sites (company
# details), cp2_user_sites (which users may open which sites) and
# cp2_site_databases (where each site's trading data actually lives).
DB_HOST=
DB_PORT=3306
DB_NAME=odyssey_tickets
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# ── Site databases ─────────────────────────────────────────────────────
# cp2_site_databases.server_host stores `localhost`, meaning localhost OF THE
# DATABASE SERVER. When this app runs anywhere else that points at the wrong
# machine, so set this to redirect every site connection at the real host
# without editing production rows. Leave blank to use the stored value.
SITE_DB_HOST_OVERRIDE=
SITE_DB_CONNECTION_LIMIT=5

# ── Server ─────────────────────────────────────────────────────────────
# Port 4100 so it never collides with the Odyssey back office on 4000.
PORT=4100

# Where this app answers from the outside. Every link that leaves in an email
# is built from it — "follow your order", "pick up where you left off" — because
# a link in somebody's inbox cannot be relative.
#
# MUST be the real public address in production. Left as localhost, those links
# are still built and still sent, and they can never work from anywhere but
# this machine. Blank is safer than wrong: the emails then simply omit the link
# rather than carrying a broken one.
APP_URL=http://localhost:4100

# ── Session ────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ── Site DB credential decryption ──────────────────────────────────────
# Decrypts cp2_site_databases.db_password_enc (enc:v1 envelope):
#   key = scryptSync(ENCRYPTION_KEY, 'odyssey-secret-v1', 32), aes-256-gcm
#
# MUST be byte-identical to the v2 backend's ENCRYPTION_KEY — that backend
# wrote the stored values. A mismatched key does not fail cleanly at connect
# time; GCM authentication fails on decrypt instead.
#
# Separate from SESSION_SECRET on purpose: rotating the session secret only
# logs everyone out, so it gets rotated casually. If it also decrypted site
# credentials, that routine act would strand every site's connection details.
ENCRYPTION_KEY=

# ── Offline till PIN verification ──────────────────────────────────────
# Lets a till check an operator's PIN with no database — see
# src/lib/offlinePin.ts. It keys the salt of a PBKDF2 verifier:
#
#   verifier = PBKDF2(pin, HMAC(OFFLINE_PIN_KEY, site|user|device), 2.4M)
#
# THIS KEY NEVER LEAVES THE SERVER. That is what makes a dumped IndexedDB
# useless: without it an attacker cannot construct the salt, so cannot even
# test a guess at a 4-digit PIN.
#
# Separate from SESSION_SECRET for the same reason ENCRYPTION_KEY is: rotating
# the session secret just logs everyone out, so it gets rotated casually.
# Rotating THIS invalidates every stored verifier, and every operator has to
# re-enter their PIN once, online, before they can sign in offline again.
#
# Leave blank and offline sign-in is simply off — the till still works online,
# and mintVerifiersForAllDevices() no-ops rather than failing a user save.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
OFFLINE_PIN_KEY=

# ── AI features ────────────────────────────────────────────────────────
# Powers "Generate a report" (/reports/ask). Leave blank and that screen says
# so rather than failing — every other report still works without it.
ANTHROPIC_API_KEY=

# ── Scheduled reports ──────────────────────────────────────────────────
# The shared secret cron sends to /api/reports/schedules/tick. There is nobody
# signed in at 07:00, so the caller proves itself with this rather than a
# cookie. Leave it blank and the endpoint refuses every request — a scheduler
# that ran wide open would let anyone trigger mail to every recipient.
#
#   */5 * * * * curl -fsS -H "Authorization: Bearer $REPORT_CRON_SECRET" \
#     https://your-host/api/reports/schedules/tick
REPORT_CRON_SECRET=

# ── Contract billing ───────────────────────────────────────────────────
# The shared secret cron sends to /api/contracts/tick, which raises invoices
# for every contract whose billing day has come and emails them. Same reasoning
# as the reports secret above: blank means the endpoint refuses every request,
# because a biller running wide open would let anyone raise invoices against
# every customer in the system.
#
# Once a day is right — billing days are dates, not times. Billing is safe to
# call more often (each period is claimed under a unique key, so nothing bills
# twice) and safe to call late (a missed month is caught up on the next run, at
# the price that was correct for that month).
#
#   5 5 * * * curl -fsS -H "Authorization: Bearer $CONTRACT_CRON_SECRET" \
#     https://your-host/api/contracts/tick
CONTRACT_CRON_SECRET=

# ── Abandoned baskets ──────────────────────────────────────────────────
# The shared secret cron sends to /api/store/baskets/tick, which emails ONE
# reminder to shoppers who saved a basket and did not come back. Same reasoning
# as the two secrets above: blank means the endpoint refuses every request,
# because a sweep running wide open would let anyone trigger mail to every
# shopper who ever saved a basket.
#
# Only shops that switch reminders on in Online store → Setup are swept, and
# only baskets somebody deliberately saved are ever stored.
#
# Every twenty minutes is a good cadence. Safe to call more often (each basket
# is claimed before its email is attempted, so nothing sends twice) and safe to
# call late — a reminder arriving a little after the shop's chosen delay is
# still useful, whereas one arriving twice is what this must never do.
#
#   */20 * * * * curl -fsS -H "Authorization: Bearer $BASKET_CRON_SECRET" \
#     https://your-host/api/store/baskets/tick
BASKET_CRON_SECRET=

# ── Scheduled page publishing ──────────────────────────────────────────
# The shared secret cron sends to /api/storefront/publish, which puts live every
# storefront page whose chosen moment has come. Same reasoning as the secrets
# above: blank means the endpoint refuses every request, because a publisher
# running wide open would let anyone push every shop's draft live.
#
# Every five minutes. This one fires at a TIME an owner typed rather than on a
# date, so "live at 6am" landing at 6pm would be a different day's trading.
#
#   */5 * * * * curl -fsS -H "Authorization: Bearer $STOREFRONT_CRON_SECRET" \
#     https://your-host/api/storefront/publish
STOREFRONT_CRON_SECRET=

# ── Scheduled price changes ────────────────────────────────────────────
# The shared secret cron sends to /api/pricing/schedules/tick, which applies
# every price change whose moment has come. Same reasoning as the secrets above,
# and it matters most here: an endpoint that reprices a shop's whole catalogue
# is not one to leave running wide open.
#
# Every five minutes, but being late is survivable in a way the others are not.
# The TILLS do not wait for this — they carry the pending change and switch on
# their own clock at the exact minute, offline or not. This tick brings the
# database into line so the back office, the reports and the online store agree
# with what the terminals are already charging.
#
# Safe to call often (each change is claimed with a conditional update, so two
# overlapping runs cannot both apply it) and safe to call late (everything
# overdue is applied on the next pass).
#
#   */5 * * * * curl -fsS -H "Authorization: Bearer $PRICING_CRON_SECRET" \
#     https://your-host/api/pricing/schedules/tick
PRICING_CRON_SECRET=

# The public origin used to build "pay this invoice" links and the URLs handed
# to the payment gateway. Usually detected from the request; set it explicitly
# when the app sits behind a proxy that rewrites the host, or a link in an
# emailed invoice will point somewhere the customer cannot reach.
PUBLIC_ORIGIN=

# ── Email ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OdysseyAI <noreply@example.com>

# ── Development conveniences ───────────────────────────────────────────
# Set to 1 to let one account hold several sessions at once.
#
# Normally a sign-in evicts the account's previous session: the back office is
# licensed per user, and without eviction one login could be shared by a whole
# company. Locally that rule gets in the way — a second browser tab, or an
# automated verification run signing in while you are mid-task, displaces the
# session you are working in and drops you at the login screen.
#
# ONLY has an effect outside a production build. `next build`/`next start` set
# NODE_ENV=production, and the check in lib/auth.ts requires BOTH, so leaving
# this set in a deployed environment cannot switch enforcement off on the live
# product. Leave it blank or unset to keep the normal behaviour in dev too.
ALLOW_MULTIPLE_SESSIONS=

# ── Local backend: the cloud side ──────────────────────────────────────
# Only needed on the server that hosts replicas and receives archives for
# sites whose data lives on the shop's own machine. A deployment with no
# local-backend sites needs none of this.
#
# The long-running process:
#
#   node --env-file=.env server/replicaHost.mjs
#
# It terminates the WebSocket tunnel each shop dials out to, and takes the
# nightly encrypted archive. It is NOT part of the Next app: a route handler
# cannot do an HTTP upgrade, and cannot stream a several-hundred-megabyte body
# to disk without buffering it.
REPLICA_HOST_PORT=4200
REPLICA_HOST_BIND=0.0.0.0
# Where archives land. One directory per site, per machine, per run.
REPLICA_ARCHIVE_DIR=archives
# Where each site's replication applier listens, on this machine.
REPLICA_APPLIER_HOST=127.0.0.1

# The MySQL/MariaDB instance the replicas themselves live in. Used by
# scripts/replica-provision.mjs to create a database and its two accounts.
REPLICA_DB_HOST=127.0.0.1
REPLICA_DB_PORT=3306
REPLICA_DB_ADMIN_USER=root
REPLICA_DB_ADMIN_PASSWORD=
# Pool size the APP uses when reading a replica for a report.
REPLICA_DB_CONNECTION_LIMIT=5

# Machines other than this one that may reach the DEV server (LAN demo).
# Comma-separated hosts, no port. Empty in normal use.
DEV_LAN_ORIGINS=

# ── DESKTOP AUTO-UPDATE ─────────────────────────────────────────────────────
#
# Where a packaged Odyssey looks for new versions. Baked into the installer by
# scripts/make-build-defaults.mjs — a packaged app has no .env, so this has to
# travel with it.
#
# The PUBLIC read URL of the release bucket, without a trailing folder:
# electron/updater.js appends `backoffice/`, `pos/` or `database/` itself,
# because electron-builder calls every manifest latest.yml and three of them in
# one folder leaves one.
#
# Unset is allowed and is what a dev checkout wants. The build still succeeds;
# make-build-defaults warns, and the app logs "No update server configured for
# this build" once at startup rather than failing silently forever.
ODYSSEY_UPDATE_URL=https://updates.odysseysoftware.co.za

# The same bucket, from the WRITE side — used only by
# `npm run publish:release`, never by the app, and never baked into an
# installer. R2 speaks S3, so the AWS CLI is what uploads.
R2_BUCKET=odyssey-releases
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# An R2 API token scoped to that bucket. Object Read & Write, nothing else:
# this credential can replace the installer a thousand shops will run.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uncomment if `aws` starts refusing with a checksum or "not implemented"
# error: recent AWS CLI versions send integrity headers R2 does not accept.
# No region setting is needed — publish-release.mjs passes --region auto.
#AWS_REQUEST_CHECKSUM_CALCULATION=when_required
#AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
