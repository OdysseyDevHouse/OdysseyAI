<?xml version="1.0" encoding="utf-8"?>
<!-- An input. Matches the web kit's controls: 8dp radius, hairline border,
     the app's own surface rather than the system's white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="#111820" />
  <stroke android:width="1dp" android:color="#2b3540" />
  <corners android:radius="8dp" />
</shape>
