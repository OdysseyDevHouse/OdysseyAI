<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!--
      The login screen's theme.

      It MUST descend from Theme.AppCompat: LoginActivity is an
      AppCompatActivity (BiometricPrompt requires one) and setContentView throws
      "You need to use a Theme.AppCompat theme" under anything else. Pointing it
      at NoActionBarLaunch — the splash theme, which is not AppCompat — crashed
      the app on launch before a single pixel rendered.

      The window background is the app's canvas rather than the splash drawable,
      so the moment between splash and form is one flat colour instead of a logo
      that jumps.
    -->
    <style name="AppTheme.Login" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/odysseyCanvas</item>
        <item name="android:statusBarColor">@color/odysseyCanvas</item>
        <item name="android:navigationBarColor">@color/odysseyCanvas</item>
    </style>
</resources>